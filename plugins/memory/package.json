{
  "name": "@cyrus/dsh-memory",
  "description": "Personal 长期记忆：分片 SQLite + FTS5 + 显式工具（P1 最小存储）",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "lib/index.js",
    "lib/core/embedding-worker.js",
    "lib/client.js",
    "lib/client.js.map",
    "migrations/*.sql"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "tsdown"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "@huggingface/transformers": "4.2.0",
    "onnxruntime-node": "1.24.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dshComposable": {
    "schemaVersion": 1,
    "role": "core",
    "supports": {
      "harness": [
        "0.1.1-rc.2"
      ]
    }
  }
}
