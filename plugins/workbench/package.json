{
  "name": "@cyrus/dsh-workbench",
  "description": "在右侧统一管理文件、代码、Diff、浏览器、终端与详情视图。",
  "version": "0.1.0-rc.8",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@cyrus/dsh-personal-shell",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@cyrus/dsh-personal-shell": "*",
    "@cyrus/dsh-session-terminal": "*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@cyrus/dsh-workspace-hub": "*"
  },
  "license": "MIT",
  "dshComposable": {
    "schemaVersion": 1,
    "role": "core",
    "requires": {
      "packages": [
        "@cyrus/dsh-personal-shell",
        "@cyrus/dsh-workspace-hub"
      ],
      "services": []
    },
    "supports": {
      "harness": [
        "0.1.1-rc.2"
      ]
    }
  }
}
