{
  "name": "@cyrus/dsh-project-control",
  "description": "项目控制台：扫描、审阅并只读关联现有项目，保留真实数据库状态与项目列表。",
  "version": "0.1.0-rc.8",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@cyrus/dsh-personal-shell",
        "@cyrus/dsh-workbench",
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "migrations/*.sql",
    "templates/**/template.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "tsdown"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "peerDependencies": {
    "@cyrus/dsh-personal-shell": "*",
    "@cyrus/dsh-workbench": "*",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "dshComposable": {
    "schemaVersion": 1,
    "role": "core",
    "supports": {
      "harness": [
        "0.1.1-rc.2"
      ]
    }
  }
}
