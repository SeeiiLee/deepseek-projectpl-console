{
  "name": "@cyrus/dsh-session-terminal",
  "description": "为每个会话提供可折叠、多标签、可重连的持久 PowerShell。",
  "version": "0.1.0-rc.8",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke:powershell": "node test/powershell.smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "react": "^18.2.0"
  },
  "dshComposable": {
    "schemaVersion": 1,
    "role": "core",
    "supports": {
      "harness": [
        "0.1.1-rc.2"
      ]
    }
  }
}
