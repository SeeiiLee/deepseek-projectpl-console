{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-personal:project-control:v1alpha1:lifecycle-normalized-event",
  "title": "Project Control Lifecycle Normalized Event v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "schemaVersion",
    "eventId",
    "eventType",
    "occurredAt",
    "recordedAt",
    "sequence",
    "actor",
    "target",
    "beforeRevision",
    "afterRevision",
    "causation",
    "provenance",
    "data"
  ],
  "properties": {
    "protocolVersion": {
      "const": "project-control.dsh/v1alpha1"
    },
    "schemaVersion": {
      "const": "lifecycle-normalized-event/v1alpha1"
    },
    "eventId": {
      "$ref": "#/$defs/eventId"
    },
    "eventType": {
      "enum": [
        "project.legacy.registered",
        "project.managed.registered",
        "project.managed.created",
        "project.location.rebound",
        "project.managed.upgraded"
      ]
    },
    "occurredAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "recordedAt": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "actor": {
      "$ref": "#/$defs/actorRef"
    },
    "target": {
      "$ref": "#/$defs/projectTarget"
    },
    "beforeRevision": {
      "type": "integer",
      "minimum": 0
    },
    "afterRevision": {
      "type": "integer",
      "minimum": 1
    },
    "causation": {
      "$ref": "#/$defs/causation"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/legacyRegisteredData"
        },
        {
          "$ref": "#/$defs/managedRegisteredData"
        },
        {
          "$ref": "#/$defs/managedCreatedData"
        },
        {
          "$ref": "#/$defs/locationReboundData"
        },
        {
          "$ref": "#/$defs/managedUpgradedData"
        }
      ]
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "project.legacy.registered"
          }
        }
      },
      "then": {
        "properties": {
          "beforeRevision": {
            "const": 0
          },
          "afterRevision": {
            "const": 1
          },
          "causation": {
            "allOf": [
              {
                "$ref": "#/$defs/causation"
              },
              {
                "type": "object",
                "properties": {
                  "commandKind": {
                    "const": "project.registerLegacy"
                  }
                }
              }
            ]
          },
          "data": {
            "$ref": "#/$defs/legacyRegisteredData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "project.managed.registered"
          }
        }
      },
      "then": {
        "properties": {
          "beforeRevision": {
            "const": 0
          },
          "afterRevision": {
            "const": 1
          },
          "causation": {
            "allOf": [
              {
                "$ref": "#/$defs/causation"
              },
              {
                "type": "object",
                "properties": {
                  "commandKind": {
                    "const": "project.registerManaged"
                  }
                }
              }
            ]
          },
          "data": {
            "$ref": "#/$defs/managedRegisteredData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "project.managed.created"
          }
        }
      },
      "then": {
        "properties": {
          "beforeRevision": {
            "const": 0
          },
          "afterRevision": {
            "const": 1
          },
          "causation": {
            "allOf": [
              {
                "$ref": "#/$defs/causation"
              },
              {
                "type": "object",
                "properties": {
                  "commandKind": {
                    "const": "project.createFromTemplate"
                  }
                }
              }
            ]
          },
          "data": {
            "$ref": "#/$defs/managedCreatedData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "project.location.rebound"
          }
        }
      },
      "then": {
        "properties": {
          "beforeRevision": {
            "type": "integer",
            "minimum": 1
          },
          "afterRevision": {
            "type": "integer",
            "minimum": 2
          },
          "causation": {
            "allOf": [
              {
                "$ref": "#/$defs/causation"
              },
              {
                "type": "object",
                "properties": {
                  "commandKind": {
                    "const": "project.rebindLocation"
                  }
                }
              }
            ]
          },
          "data": {
            "$ref": "#/$defs/locationReboundData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "project.managed.upgraded"
          }
        }
      },
      "then": {
        "properties": {
          "beforeRevision": {
            "type": "integer",
            "minimum": 1
          },
          "afterRevision": {
            "type": "integer",
            "minimum": 2
          },
          "causation": {
            "allOf": [
              {
                "$ref": "#/$defs/causation"
              },
              {
                "type": "object",
                "properties": {
                  "commandKind": {
                    "const": "project.upgradeManaged"
                  }
                }
              }
            ]
          },
          "data": {
            "$ref": "#/$defs/managedUpgradedData"
          }
        }
      }
    }
  ],
  "$defs": {
    "projectId": {
      "type": "string",
      "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^evt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "planId": {
      "type": "string",
      "pattern": "^pln_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "locationRef": {
      "type": "string",
      "pattern": "^loc_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sourceRootRef": {
      "type": "string",
      "pattern": "^srt_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{3})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*[:\\\\])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])(?!.*//)(?!.*\\/$)[^/]+(?:/[^/]+)*$"
    },
    "actorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "applicationId"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "system",
            "application"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "applicationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,127}$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "projectTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregateType",
        "projectId"
      ],
      "properties": {
        "aggregateType": {
          "const": "project"
        },
        "projectId": {
          "$ref": "#/$defs/projectId"
        }
      }
    },
    "causation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "commandKind",
        "idempotencyKey",
        "correlationId"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "commandKind": {
          "enum": [
            "project.registerLegacy",
            "project.registerManaged",
            "project.createFromTemplate",
            "project.rebindLocation",
            "project.upgradeManaged"
          ]
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,199}$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "sourceId",
        "applicationVersion",
        "applicationInstanceId",
        "observedAt"
      ],
      "properties": {
        "sourceType": {
          "enum": [
            "human",
            "agent",
            "harness",
            "imported_document",
            "system"
          ]
        },
        "sourceId": {
          "type": "string",
          "pattern": "^(?![A-Za-z]:[\\\\/])(?!/)(?!\\\\\\\\)[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "sourceRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "applicationVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "applicationInstanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "adapterId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,127}$"
        },
        "adapterVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        },
        "observedAt": {
          "$ref": "#/$defs/utcTimestamp"
        }
      },
      "dependentRequired": {
        "adapterId": [
          "adapterVersion"
        ],
        "adapterVersion": [
          "adapterId"
        ]
      }
    },
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "relativePath",
        "contentHash"
      ],
      "properties": {
        "role": {
          "enum": [
            "readme",
            "prd",
            "devlog",
            "progress",
            "next",
            "current_architecture",
            "decision",
            "other"
          ]
        },
        "relativePath": {
          "$ref": "#/$defs/relativePath"
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "documentBindings": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/documentBinding"
      }
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateId",
        "templateVersion",
        "templateHash"
      ],
      "properties": {
        "templateId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{1,127}$"
        },
        "templateVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "templateHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "managedIdentityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "manifestHash"
      ],
      "properties": {
        "kind": {
          "const": "managed_manifest"
        },
        "manifestHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "legacyIdentityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fingerprintHash",
        "contentHashes"
      ],
      "properties": {
        "kind": {
          "const": "legacy_fingerprint"
        },
        "fingerprintHash": {
          "$ref": "#/$defs/sha256"
        },
        "contentHashes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "noWriteSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "not_required"
        }
      }
    },
    "verifiedManifestSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "manifestHash"
      ],
      "properties": {
        "status": {
          "const": "verified_existing"
        },
        "manifestHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "committedWriteSync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "planId",
        "planHash",
        "manifestHash"
      ],
      "properties": {
        "status": {
          "const": "committed"
        },
        "planId": {
          "$ref": "#/$defs/planId"
        },
        "planHash": {
          "$ref": "#/$defs/sha256"
        },
        "manifestHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "legacyRegisteredData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectMode",
        "name",
        "locationRef",
        "sourceRootRef",
        "documentBindings",
        "fileSync"
      ],
      "properties": {
        "projectMode": {
          "const": "linked_legacy"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "locationRef": {
          "$ref": "#/$defs/locationRef"
        },
        "sourceRootRef": {
          "$ref": "#/$defs/sourceRootRef"
        },
        "documentBindings": {
          "$ref": "#/$defs/documentBindings"
        },
        "fileSync": {
          "$ref": "#/$defs/noWriteSync"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "managedRegisteredData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectMode",
        "locationRef",
        "sourceRootRef",
        "manifestHash",
        "fileSync"
      ],
      "properties": {
        "projectMode": {
          "const": "managed"
        },
        "locationRef": {
          "$ref": "#/$defs/locationRef"
        },
        "sourceRootRef": {
          "$ref": "#/$defs/sourceRootRef"
        },
        "manifestHash": {
          "$ref": "#/$defs/sha256"
        },
        "fileSync": {
          "$ref": "#/$defs/verifiedManifestSync"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "managedCreatedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectMode",
        "name",
        "locationRef",
        "sourceRootRef",
        "template",
        "manifestHash",
        "fileSync"
      ],
      "properties": {
        "projectMode": {
          "const": "managed"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "locationRef": {
          "$ref": "#/$defs/locationRef"
        },
        "sourceRootRef": {
          "$ref": "#/$defs/sourceRootRef"
        },
        "template": {
          "$ref": "#/$defs/templateRef"
        },
        "manifestHash": {
          "$ref": "#/$defs/sha256"
        },
        "fileSync": {
          "$ref": "#/$defs/committedWriteSync"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "locationReboundData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectMode",
        "previousLocationRef",
        "newLocationRef",
        "sourceRootRef",
        "reason",
        "identityEvidence",
        "fileSync"
      ],
      "properties": {
        "projectMode": {
          "enum": [
            "linked_legacy",
            "managed"
          ]
        },
        "previousLocationRef": {
          "$ref": "#/$defs/locationRef"
        },
        "newLocationRef": {
          "$ref": "#/$defs/locationRef"
        },
        "sourceRootRef": {
          "$ref": "#/$defs/sourceRootRef"
        },
        "reason": {
          "enum": [
            "moved",
            "renamed",
            "recovered"
          ]
        },
        "identityEvidence": {
          "oneOf": [
            {
              "$ref": "#/$defs/managedIdentityEvidence"
            },
            {
              "$ref": "#/$defs/legacyIdentityEvidence"
            }
          ]
        },
        "fileSync": {
          "$ref": "#/$defs/noWriteSync"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "projectMode": {
                "const": "managed"
              }
            }
          },
          "then": {
            "properties": {
              "identityEvidence": {
                "$ref": "#/$defs/managedIdentityEvidence"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "projectMode": {
                "const": "linked_legacy"
              }
            }
          },
          "then": {
            "properties": {
              "identityEvidence": {
                "$ref": "#/$defs/legacyIdentityEvidence"
              }
            }
          }
        }
      ]
    },
    "managedUpgradedData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previousMode",
        "projectMode",
        "locationRef",
        "manifestHash",
        "fileSync"
      ],
      "properties": {
        "previousMode": {
          "const": "linked_legacy"
        },
        "projectMode": {
          "const": "managed"
        },
        "locationRef": {
          "$ref": "#/$defs/locationRef"
        },
        "manifestHash": {
          "$ref": "#/$defs/sha256"
        },
        "fileSync": {
          "$ref": "#/$defs/committedWriteSync"
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    },
    "extensions": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "pattern": "^(?:[a-z][a-z0-9-]*\\.)+[a-z][a-z0-9-]*$"
      },
      "additionalProperties": true
    }
  }
}
