{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsh-personal:project-control:v1alpha1:approval-action-result",
  "title": "Approval Action Result v1alpha1",
  "description": "Host result for an approval action command. It carries stable error codes when the command was not applied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "command_id",
    "card_id",
    "applied",
    "error_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "approval-action-result/v1alpha1"
    },
    "command_id": {
      "$ref": "#/$defs/commandId"
    },
    "card_id": {
      "$ref": "#/$defs/cardId"
    },
    "applied": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "queued",
        "pending_clarification",
        "machine_rejected",
        "approved",
        "approved_with_constraints",
        "rejected_with_direction",
        "rejected_final",
        "delegated",
        "snoozed",
        "noted",
        "auto_effective"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "decided_at": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/utcTimestamp"
        }
      ]
    },
    "error_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "applied": {
            "const": true
          }
        },
        "required": [
          "applied"
        ]
      },
      "then": {
        "required": [
          "status",
          "revision"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "error_codes": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applied": {
            "const": false
          }
        },
        "required": [
          "applied"
        ]
      },
      "then": {
        "properties": {
          "error_codes": {
            "type": "array",
            "minItems": 1
          },
          "status": false,
          "revision": false
        }
      }
    }
  ],
  "$defs": {
    "commandId": {
      "type": "string",
      "pattern": "^cmd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "cardId": {
      "type": "string",
      "pattern": "^crd_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-([0-2]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{3})?Z$"
    }
  }
}
